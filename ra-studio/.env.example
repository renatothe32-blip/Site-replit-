# Root env example - copy to .env and edit

# App
NEXT_PUBLIC_API_URL=http://localhost:4000
JWT_SECRET=your_jwt_secret_here
NODE_ENV=development
PORT_WEB=3000
PORT_API=4000

# Postgres
POSTGRES_URL=postgresql://postgres:postgres@db:5432/rastudio?schema=public

# Prisma
DATABASE_URL=postgresql://postgres:postgres@db:5432/rastudio

# Runner (shared secret between API and runner)
RUNNER_SECRET=please_change_runner_secret
# Runner will call the API using this base URL (from inside docker-compose use http://api:4000)
RUNNER_API_URL=http://api:4000
